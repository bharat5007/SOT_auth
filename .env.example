# Database Configuration
AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/auth_db

# JWT Settings
AUTH_SECRET_KEY=your-super-secret-key-change-this-in-production-use-at-least-32-characters
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# SHARED CONTEXT (for microservices communication)
AUTH_SHARED_CONTEXT_SECRET=your-shared-context-secret-change-this-in-production-use-at-least-32-characters
AUTH_SHARED_CONTEXT_EXPIRE_MINUTES=15

# Application Settings
AUTH_APP_NAME=Auth Microservice
AUTH_DEBUG=False

PASSWORD_ENCODE_KEY=sot_staging

# CORS Settings (comma-separated list)
AUTH_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8001","http://localhost:8080","https://your-frontend-domain.com"]
